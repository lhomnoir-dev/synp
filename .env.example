# Configuration PromptHub API
# Copiez ce fichier vers .env et adaptez les valeurs

DATABASE_URL=postgresql+psycopg2://prompthub:prompthub@localhost:5432/prompthub
SECRET_KEY=changez-cette-cle-en-production
ENCRYPTION_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

CORS_ORIGINS=["http://localhost:8000","http://localhost:5173"]

# Clés API LLM (serveur) - optionnel
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
